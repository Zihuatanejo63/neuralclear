# Blackbox checks the certificate Caddy presents for the public name.
# NEURALCLEAR_DOMAIN_PLACEHOLDER is replaced at container start. The probe
# connects to the caddy service and sets SNI and Host to that name.

modules:
  http_cert:
    prober: http
    timeout: 10s
    http:
      method: GET
      valid_status_codes: [200]
      fail_if_not_ssl: true
      follow_redirects: false
      preferred_ip_protocol: ip4
      tls_config:
        server_name: NEURALCLEAR_DOMAIN_PLACEHOLDER
      headers:
        Host: NEURALCLEAR_DOMAIN_PLACEHOLDER
